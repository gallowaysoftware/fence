{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gallowaysoftware/fence/protocol/schema/decide.request.schema.json",
  "title": "decide request",
  "description": "POST /v1/decide. The bridge must answer within deadline_ms with one of options, or defer.",
  "type": "object",
  "required": ["session_id", "decision_id", "kind", "game_day", "deadline_ms", "context", "options"],
  "additionalProperties": false,
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "game_day": {"type": "integer", "minimum": 0},
    "deadline_ms": {"type": "integer", "minimum": 1},
    "state_signature": {"type": "string", "description": "Opaque; derived by the mod from the state it sent and re-checked before executing. The bridge only logs it."},
    "context": {"type": "object", "description": "Kind-specific state; open. See docs/re/."},
    "options": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/option"}},
    "hidden": {"type": "object", "description": "Internal values the player cannot see (true features, appraisal value, …). Logged for evaluation and training labels; never put in a prompt. Open."}
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "not": {"const": "defer"}, "description": "\"defer\" is reserved: it is always legal and never enumerated."},
        "label": {"type": "string"},
        "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/param"}}
      }
    },
    "param": {
      "description": "Discriminated by type. A new param type is a new branch here plus a value check in the bridge; an older bridge treats options with unknown param types as unchoosable.",
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"type": "string"}},
      "oneOf": [{"$ref": "#/$defs/int_param"}]
    },
    "int_param": {
      "type": "object",
      "required": ["type", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "int"},
        "min": {"type": "integer"},
        "max": {"type": "integer"}
      }
    }
  }
}
