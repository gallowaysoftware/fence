# Copy to ~/.config/fence/bridge.env (make service-install does this once) and edit.
# Every variable is optional; the unit's defaults are observe mode with memory on.
# Restart after editing: systemctl --user restart fence-bridge

# observe: record only. advise: also ask the model and show its advice. act: execute it.
FENCE_MODE=observe

# Model, needed for advise/act and for nightly reflection. Leave FENCE_POLICY=heuristic to
# run without one.
FENCE_POLICY=heuristic
#FENCE_POLICY=llm
#FENCE_PROVIDER=openai
#FENCE_BASE_URL=http://localhost:8080/v1
#FENCE_MODEL=qwen38fn-mlx
#FENCE_NO_SCHEMA=true
#FENCE_THINKING=off
#FENCE_TEMPERATURE=0.2

# Anthropic instead:
#FENCE_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#FENCE_MODEL=

#FENCE_LISTEN=127.0.0.1:7341
#FENCE_MEMORY_CARRY_LESSONS=true
