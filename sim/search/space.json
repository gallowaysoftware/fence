{
  "_doc": [
    "The -human knobs space (the v1/v2 knob family). The default space is space-player.json.",
    "Search space for sim/search/search.py: every strategy knob of sim/gym/Knobs.cs plus the gym flags -permit, -upgrades, -perks.",
    "Knob types: cat (values, optional prior weights), int/float (lo, hi, optional log scale; optional=true adds an on/off gate, off = knob unset),",
    "subset (an ordered pool joined with '+'; each item an independent Bernoulli; budget/max_items/incompatible repair the sample).",
    "default: the value that behaves like an unset knob (dropped from the canonical key). when: emit only if another knob has one of these values.",
    "flag: a gym flag instead of a -knobs entry. Names under knobs must exist in Knobs.cs (checked at startup)."
  ],
  "human": "knobs",
  "refs": {
    "base": [],
    "G": ["-knobs", "bargain=ev,max_heat=101,sell_hot=0,window=concentrate"],
    "G_wsonly": ["-knobs", "bargain=ev,max_heat=101,sell_hot=0,window=concentrate,buy_margin=1.1,ws_margin=1.0"]
  },
  "knobs": {
    "services":        {"type": "cat", "values": ["default", "both", "ins", "jan", "none"], "prior": [3, 3, 1, 1, 0.5], "default": "default"},
    "svc_nights":      {"type": "int", "lo": 0, "hi": 14, "optional": true, "p_on": 0.3},
    "scav":            {"type": "cat", "values": ["always", "never"], "prior": [3, 1], "default": "always"},
    "scav_risk":       {"type": "float", "lo": 2, "hi": 40, "optional": true, "p_on": 0.2, "when": {"scav": ["always"]}},
    "window":          {"type": "cat", "values": ["types", "concentrate", "top", "empty"], "prior": [3, 2, 2, 0.5], "default": "types"},
    "window_n":        {"type": "int", "lo": 1, "hi": 35, "optional": true, "p_on": 0.3, "when": {"window": ["types", "concentrate", "top"]}},
    "window_hot":      {"type": "cat", "values": ["0", "1"], "prior": [3, 1], "default": "0"},
    "sell_hot":        {"type": "cat", "values": ["1", "0"], "default": "1"},
    "sell_contraband": {"type": "cat", "values": ["1", "0"], "default": "1"},
    "max_stage":       {"type": "int", "lo": 1, "hi": 14, "optional": true, "p_on": 0.4},
    "spec":            {"type": "cat", "values": ["0", "1"], "default": "0"},
    "dlg":             {"type": "cat", "values": ["first", "smart"], "prior": [3, 1], "default": "first"},
    "bargain":         {"type": "cat", "values": ["discount", "never", "ev", "aggr"], "prior": [2, 1, 3, 0.5], "default": "discount"},
    "bargain_pct":     {"type": "cat", "values": ["10", "25", "50"], "default": "25", "when": {"bargain": ["aggr"]}},
    "buy_margin":      {"type": "float", "lo": 0.85, "hi": 1.5, "default": 1.0, "digits": 2},
    "ws_margin":       {"type": "float", "lo": 0.7, "hi": 1.6, "optional": true, "p_on": 0.5, "digits": 2},
    "max_heat":        {"type": "int", "lo": 1, "hi": 101, "default": 50},
    "buy_contraband":  {"type": "cat", "values": ["0", "1"], "prior": [4, 1], "default": "0"},
    "reserve":         {"type": "cat", "values": ["rent2", "rent", "none"], "default": "rent2"},
    "floor":           {"type": "int", "lo": 0, "hi": 800, "optional": true, "p_on": 0.25},
    "save_permit":     {"type": "int", "lo": 20, "hi": 79, "optional": true, "p_on": 0.3},
    "stock_cap":       {"type": "int", "lo": 300, "hi": 12000, "log": true, "optional": true, "p_on": 0.25},
    "nice_faction":    {"type": "cat", "values": ["", "upper_levels", "revolution", "black_market", "lower_levels"], "prior": [6, 1, 1, 1, 0.5], "default": ""},
    "nice_pct":        {"type": "cat", "values": ["10", "25"], "default": "10", "when": {"nice_faction": ["upper_levels", "revolution", "black_market", "lower_levels"]}},
    "permit":          {"type": "cat", "flag": "-permit", "values": ["buy", "refuse"], "default": "buy"},
    "upgrades":        {"type": "subset", "flag": "-upgrades", "empty": "none", "default": "LANDLORD_GRACE+SHOWCASE_I",
                        "pool": ["LANDLORD_GRACE", "SHOWCASE_I", "BUY_REFERAL", "SELL_REFERAL", "WILD_FIXER", "EVIDENCE_REMOVAL", "SEC_GRACE",
                                 "INSPECTION_INFORMANT", "TRASHCAN_UPGRADE", "RENOVATION1", "SHOWCASE_II", "RENOVATION2", "WINEMAKER",
                                 "CRIMINEL_NETWORK", "JACKSON1", "DOSSIER_UPGRADE"],
                        "p": [0.9, 0.5, 0.35, 0.35, 0.25, 0.25, 0.25, 0.2, 0.2, 0.2, 0.15, 0.15, 0.15, 0.15, 0.15, 0.15]},
    "perks":           {"type": "subset", "flag": "-perks", "empty": "", "default": "",
                        "pool": ["saving", "wild_favorite", "vending", "lucky", "intimidating", "diplomatic", "alert", "model_citizen",
                                 "well_connected", "sycophant", "secret_admirer", "proficient_scavenger", "handy", "revolution_sympathizer",
                                 "careful_scavenger", "hoarder"],
                        "cost": [1, 1, 2, 1, 2, 2, 2, 1, 2, 1, 1, 1, 1, 1, 0, 0],
                        "budget": 3, "max_items": 4, "p0": 0.15}
  }
}
