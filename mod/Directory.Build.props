<Project>
  <PropertyGroup>
    <!-- Override with -p:GameDir=... or the GAME_DIR environment variable. -->
    <GameDir Condition="'$(GameDir)' == '' and '$(GAME_DIR)' != ''">$(GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Probably Stolen</GameDir>
    <GameManaged>$(GameDir)/Probably Stolen_Data/Managed</GameManaged>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepoRoot>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
