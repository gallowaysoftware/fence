<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fence.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fence.Core/Fence.Core.csproj" />
    <ProjectReference Include="../../tools/Fence.Compat/Fence.Compat.csproj" />
    <!-- Built first so the Cecil and scanner tests can read Fence.Mod.dll; never loaded. -->
    <ProjectReference Include="../../src/Fence.Mod/Fence.Mod.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../../src/Fence.Autopilot/Fence.Autopilot.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot" Value="$(RepoRoot)" />
    <AssemblyMetadata Include="GameManaged" Value="$(GameManaged)" />
    <AssemblyMetadata Include="ModBinDir" Value="$(MSBuildThisFileDirectory)../../src/Fence.Mod/bin/$(Configuration)/netstandard2.1" />
    <AssemblyMetadata Include="AutopilotBinDir" Value="$(MSBuildThisFileDirectory)../../src/Fence.Autopilot/bin/$(Configuration)/netstandard2.1" />
  </ItemGroup>
</Project>
