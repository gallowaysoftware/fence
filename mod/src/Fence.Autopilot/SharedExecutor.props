<Project>
  <!-- The gym executor's decision files (sim/gym), compiled under the mod's rules into Fence.Autopilot (the
       scanner check) and Fence.Mod (the live autopilot). A file that needs Episode, I/O or reflection goes
       behind IExecutorHost or into a gym-only file (docs/STREAM.md section 4). -->
  <PropertyGroup>
    <GymSrc>$(RepoRoot)/sim/gym</GymSrc>
    <!-- View fields the gym's Episode fills in; never assigned inside the mod. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GymSrc)/ExecutorHost.cs" Link="Gym/ExecutorHost.cs" />
    <Compile Include="$(GymSrc)/Directives.cs" Link="Gym/Directives.cs" />
    <Compile Include="$(GymSrc)/Knobs.cs" Link="Gym/Knobs.cs" />
    <Compile Include="$(GymSrc)/HumanRole.cs" Link="Gym/HumanRole.cs" />
    <Compile Include="$(GymSrc)/KnobHumanRole.cs" Link="Gym/KnobHumanRole.cs" />
    <Compile Include="$(GymSrc)/PlayerRole.cs" Link="Gym/PlayerRole.cs" />
    <Compile Include="$(GymSrc)/Production.cs" Link="Gym/Production.cs" />
    <Compile Include="$(GymSrc)/Wine.cs" Link="Gym/Wine.cs" />
    <Compile Include="$(GymSrc)/Dna.cs" Link="Gym/Dna.cs" />
    <Compile Include="$(GymSrc)/Water.cs" Link="Gym/Water.cs" />
    <Compile Include="$(GymSrc)/Furnace.cs" Link="Gym/Furnace.cs" />
    <Compile Include="$(GymSrc)/Vending.cs" Link="Gym/Vending.cs" />
    <Compile Include="$(GymSrc)/Conceal.cs" Link="Gym/Conceal.cs" />
    <Compile Include="$(GymSrc)/Beer.cs" Link="Gym/Beer.cs" />
    <Compile Include="$(GymSrc)/Breadth.cs" Link="Gym/Breadth.cs" />
    <Compile Include="$(GymSrc)/Appraisal.cs" Link="Gym/Appraisal.cs" />
    <Compile Include="$(GymSrc)/Labels.cs" Link="Gym/Labels.cs" />
    <Compile Include="$(GymSrc)/ExecutorMorning.cs" Link="Gym/ExecutorMorning.cs" />
    <Compile Include="$(GymSrc)/PlayerCounter.cs" Link="Gym/PlayerCounter.cs" />
    <Compile Include="$(GymSrc)/NightOuting.cs" Link="Gym/NightOuting.cs" />
    <Compile Include="$(GymSrc)/WildRead.cs" Link="Gym/WildRead.cs" />
    <Compile Include="$(GymSrc)/AugRule.cs" Link="Gym/AugRule.cs" />
    <Compile Include="$(GymSrc)/Modules.cs" Link="Gym/Modules.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)DemandTrace.Off.cs" Link="Gym/DemandTrace.Off.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ModSide.Live.cs" Link="Gym/ModSide.Live.cs" />
  </ItemGroup>
</Project>
